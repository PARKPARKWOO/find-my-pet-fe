# API (백엔드 proxy. 공공데이터 유기동물 API 도 이 경로로 호출)
NEXT_PUBLIC_API_BASE_URL=https://fmp.platformholder.site/api/v1

# Kakao
NEXT_PUBLIC_KAKAO_JS_API_KEY=
NEXT_PUBLIC_AUTH_URL=https://auth.platformholder.site/oauth2/authorization/2

# Kakao AdFit (optional)
# 광고단위는 플랫폼(PC웹/모바일웹)별로 따로 만들어야 한다. 한 유닛이 두 플랫폼을 겸하지 못한다.
# _SIZE 는 "가로x세로". 생략하면 PC 728x90 / 모바일 320x100. AdFit 에 등록한 사이즈와 반드시 일치해야
# 하며, 다르면 에러 없이 그냥 빈칸이 된다.
NEXT_PUBLIC_ADFIT_UNIT_FEED=
NEXT_PUBLIC_ADFIT_UNIT_FOOTER_PC=
NEXT_PUBLIC_ADFIT_UNIT_FOOTER_PC_SIZE=
NEXT_PUBLIC_ADFIT_UNIT_FOOTER_MOBILE=
NEXT_PUBLIC_ADFIT_UNIT_FOOTER_MOBILE_SIZE=

# Google (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense (optional)
# 게시자 ID. `ca-pub-` 접두사까지 그대로 넣는다. 이 값 하나가 세 곳을 동시에 켠다:
#   1) AdSense 로더 스크립트 (AdSenseScript)
#   2) <head> 의 google-adsense-account 메타 태그 (사이트 소유 확인 수단)
#   3) /ads.txt 의 google.com 레코드
# 비워두면 셋 다 렌더되지 않고 /ads.txt 는 404 를 낸다 — 빈 ads.txt 는 "승인된 판매자 없음" 으로
# 읽혀 파일이 없는 것보다 나쁘기 때문이다.
NEXT_PUBLIC_ADSENSE_CLIENT=
# 승인 후 만든 광고 단위 슬롯 ID (홈 피드용). 미설정이면 피드 광고 자리는 placeholder 로 남는다.
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
# 구 이름. NEXT_PUBLIC_ADSENSE_CLIENT 가 없을 때만 fallback 으로 읽는다. 신규 설정에는 쓰지 말 것.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ads.txt 추가 레코드 (optional, 서버 전용)
# AdFit 등 다른 판매자가 자기 레코드를 요구할 때 개행으로 구분해 넣는다. 예:
#   ADS_TXT_EXTRA="kakao.com, 12345, DIRECT"
# 형식(도메인, 게시자ID, DIRECT|RESELLER[, 인증기관ID])은 각 판매자가 지정한 문자열을 그대로 쓴다.
ADS_TXT_EXTRA=
